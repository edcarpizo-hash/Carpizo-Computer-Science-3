# Class for the characters
class Hero:
  def __init__(self, name, health):
    self.name = name
    self.health = health

  def take_damage(self, damage):
    self.health -= damage

  def stats(self):
    return f"{self.name}: {self.health} health"

# Creates two heroes
arthur = Hero("Arthur", 100)
morgana = Hero("Morgana", 100)

# Makes arthur take 10 damage
arthur.take_damage(10)

# Print both heroes' health
print(f"Arthur's health after taking damage: {arthur.health}")
print(f"Morgana's health: {morgana.health}")

# Prints who is at full health
if arthur.health == 100:
  print(f"{arthur.name} is at full health.")
if morgana.health == 100:
  print(f"{morgana.name} is at full health.")
  
# Prints the heroes' stats
print(arthur.stats())
print(morgana.stats())